# 统一换行，避免 Windows/Linux 协作时整文件 diff
* text=auto eol=lf

# Visual Studio 解决方案文件保持 CRLF
*.sln    text eol=crlf
*.csproj text eol=crlf
*.props  text eol=crlf
*.targets text eol=crlf

# 语言相关
*.cs     text diff=csharp
*.md     text
*.json   text
*.yml    text
*.yaml   text

# 二进制
*.png    binary
*.jpg    binary
*.ico    binary
*.exe    binary
*.dll    binary
*.sys    binary
*.zip    binary
